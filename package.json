{
  "name": "proftopdf",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/prepare-ffmpeg.mjs && node scripts/prepare-pdf.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run check:configuration && npm run check:repository",
    "check:configuration": "node --import tsx scripts/check-configuration.ts",
    "check:repository": "node scripts/check-repository.mjs",
    "verify:infra": "node scripts/verify-infrastructure.mjs",
    "verify:quotas": "node --import tsx scripts/verify-atomic-quota.ts",
    "verify:auth": "node --conditions=react-server --import tsx scripts/verify-auth.ts",
    "verify:audio-assets": "node scripts/verify-audio-assets.mjs",
    "verify:audio-core": "node --import tsx scripts/verify-audio-core.mts",
    "verify:mp3": "node --import tsx scripts/verify-mp3.mts",
    "verify:audio-validation": "node --import tsx scripts/verify-audio-validation.mts",
    "verify:audio-metadata": "node --import tsx scripts/verify-audio-metadata.mts",
    "verify:processing": "node --conditions=react-server --import tsx scripts/verify-processing.mts",
    "verify:notes": "node --conditions=react-server --import tsx scripts/verify-notes.mts",
    "verify:source-contract": "node --conditions=react-server --import tsx scripts/verify-source-contract.mts",
    "verify:openai": "node --import tsx scripts/verify-openai.mts",
    "verify:llm-cascade": "node --conditions=react-server --import tsx scripts/verify-llm-cascade.mts",
    "verify:llm-locks": "node --conditions=react-server --import tsx scripts/verify-llm-locks.mts",
    "inspect:quota": "node --conditions=react-server --import tsx scripts/inspect-quota.mts",
    "benchmark:notes": "node --import tsx scripts/benchmark-notes.mts",
    "benchmark:llm-cascade": "node --import tsx scripts/benchmark-llm-cascade.mts",
    "verify:pdf": "node scripts/verify-pdf.mjs",
    "assets:generate": "node scripts/generate-brand-assets.mjs",
    "test": "node --import tsx --test tests/unit/*.test.ts"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@noble/hashes": "2.4.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@upstash/redis": "1.39.0",
    "groq-sdk": "1.6.0",
    "idb": "8.0.4",
    "js-tiktoken": "1.0.21",
    "mathjax-full": "3.2.2",
    "next": "16.4.2",
    "openai": "7.36.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "server-only": "0.0.1",
    "zod": "^4.1.12"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.18.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.6",
    "prettier": "3.9.10",
    "sharp": "^0.34.4",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
